{
  "run_command": {
    "*": "allow",
    "rm -rf /": "deny",
    "rm -rf ~": "deny",
    "rm -rf *": "deny",
    "git push *--force*": "deny",
    "git push *-f *": "deny",
    "git reset --hard*": "deny",
    "git clean -fd": "deny",
    "sudo rm *": "deny",
    "sudo rm -rf *": "deny",
    "chmod 777 *": "deny",
    "chmod -R 777 *": "deny",
    "shutdown *": "deny",
    "reboot": "deny",
    "reboot *": "deny",
    "format *": "deny",
    "dd if=*": "deny",
    "kill -9 *": "deny",
    "killall *": "deny"
  },
  "run_code": {
    "*": "allow"
  },
  "file_ops": {
    "*": "allow"
  },
  "system_health": "allow",
  "read_file": "allow",
  "code_analysis": "allow",
  "remember": "allow",
  "recall": "allow",
  "forget": "allow",
  "agent": "allow"
}
