# NALLY Configuration
# Copy to .env and fill in your values: cp .env.example .env

# Provider: "opencode", "groq", or "nim"
NALLY_PROVIDER=opencode

# LLM API Keys (only the one matching your provider is needed)
# OpenCode: supports multiple comma-separated keys for automatic rotation on rate limits
OPENCODE_API_KEY=your-opencode-api-key
# OPENCODE_API_KEY=sk-key1,sk-key2,sk-key3
GROQ_API_KEY=your-groq-api-key
# NVIDIA NIM: free tier (40 RPM), get key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nim-api-key

# Auth token for web UI / API access
NALLY_ACCESS_TOKEN=your-secret-access-token
# Separate credential for standalone Telegram bot -> web server calls.
# Use a long random value (at least 32 characters).
NALLY_INTERNAL_TOKEN=your-long-random-internal-token

# Session and personality
NALLY_SESSION=default
NALLY_PERSONALITY=nally

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:9000,http://127.0.0.1:9000

# Public base URL (e.g. https://nally.onrender.com)
# Used for OAuth redirects, Telegram bot HTTP forwarding, and startup banner.
# Falls back to http://localhost:<port> for local dev.
NALLY_BASE_URL=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=60

# Database — durable memory backend (auto-detected; explicit override via NALLY_MEMORY_BACKEND)
# Local dev (default): leave DATABASE_URL unset or as a file path -> SQLite (data/nally_memory.db)
# Neon/Supabase: set DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require  (or postgres://)
# Turso/LibSQL (legacy): TURSO_URL + TURSO_TOKEN
# NALLY_MEMORY_BACKEND: postgres | sqlite | turso | "" (auto) — explicit override, preferred on Render
DATABASE_URL=
NALLY_MEMORY_BACKEND=
TURSO_URL=
TURSO_TOKEN=

# Layerbase (PostgreSQL + Redis)
LAYERBASE_API_KEY=
LAYERBASE_DB_ID=
REDIS_URL=
REDIS_TOKEN=

# Google
GOOGLE_CREDENTIALS_FILE=
# OAuth client credentials for Google Workspace MCP (Gmail/Drive/Calendar).
# Required by mcp/oauth.py and tools/gmail.py (used for token refresh).
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (for MCP server — create at https://github.com/settings/applications/new)
# Callback URL: http://localhost:5000/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Slack
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
# Webhook URL for production mode (e.g. https://your-domain.com)
# Leave empty for polling mode (default, good for dev)
TELEGRAM_WEBHOOK_URL=
# Mode: auto (default), polling, webhook, or off
#   auto:    webhook if TELEGRAM_WEBHOOK_URL is set, else polling
#   polling: standalone bot process polls Telegram (bot owns I/O, web server owns approvals)
#   webhook: web server owns Telegram via webhook only
#   off:     never start a Telegram bot
TELEGRAM_MODE=auto

# Telegram User Account (Telethon — real user, not a bot)
# Only interacts with the configured owner. Get API creds from my.telegram.org
TELEGRAM_USER_API_ID=
TELEGRAM_USER_API_HASH=
TELEGRAM_USER_PHONE=
TELEGRAM_USER_ID=

# Parallel.ai (web search)
PARALLEL_API_KEY=

# ── Observability (OpenTelemetry / Prometheus / OTLP) ──
# Port for the Prometheus /metrics HTTP endpoint (0 disables). Default 8000.
OTEL_METRICS_PORT=8000
# OTLP trace exporter endpoint (e.g. http://localhost:4318/v1/traces). Empty = metrics only.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Agent Limits ──
NALLY_MAX_TOOL_CALLS=50
NALLY_MAX_ITERATIONS=25
NALLY_MAX_TOOL_OUTPUT=50000
NALLY_MAX_AGENT_WALL_TIME=300
NALLY_RECURSION_LIMIT=50
NALLY_APPROVAL_TIMEOUT=1800

# Agent safety circuit breakers
NALLY_MAX_SUBAGENT_DEPTH=2          # Max nested sub-agent levels (agent -> subagent -> subagent)
NALLY_TOOL_RETRY_LIMIT=3            # Max attempts for a single tool call before reporting the error
NALLY_MAX_TOOL_FAILURES_PER_TURN=8  # Max failed tool calls per turn before the agent halts
NALLY_TOKEN_WARN_THRESHOLD=0.8      # Fraction of context at which Nally warns and summarizes
NALLY_BUDGET_WARN_THRESHOLD=0.8     # Fraction of execution budget at which Nally nudges the agent once (internal only, never blocks completion)
NALLY_CMD_TIMEOUT=60                # Default command/run_code timeout (seconds)

# Daily token budget (resets at midnight UTC). 0 = unlimited.
# Gates plan-and-execute and other token-heavy features.
NALLY_DAILY_TOKEN_BUDGET=500000

# Planning — NALLY_PLAN_ENABLED is an operational kill-switch, not a user mode.
# When false, COMPLEX tasks downgrade to REACT and no plan topology is built.
# Default true (planning automatic via TaskRouter); set false only to forcibly
# disable planning for a deployment.NALLY_PLAN_ENABLED=false
NALLY_PLAN_MAX_STEPS=10
NALLY_PLAN_MAX_REVISIONS=3
NALLY_PLAN_STEP_TIMEOUT=300
NALLY_PLAN_STEP_MAX_ITERATIONS=15

# Thinking
NALLY_THINKING_ENABLED=true
NALLY_THINKING_MAX_STRATEGIES=3
NALLY_THINKING_MODEL=
NALLY_THINKING_TIMEOUT=30

# Harness v2 (intent classification + pipeline routing)
# Master switch — turns on all harness stages (classification, scratchpad,
# critique, tool-verify). Set to "true" when you want Nally's "serious mode"
# identity active. Default "false" keeps her in light chat mode.
NALLY_HARNESS_ENABLED=false         # Master switch for the Harness pipeline
NALLY_HARNESS_ROUTER=true           # Intent classifier
NALLY_HARNESS_CRITIQUE=true         # Critique stage
NALLY_HARNESS_SCRATCHPAD=true       # Working-memory scratchpad
NALLY_HARNESS_VERIFY=true           # Post-response claim verification
NALLY_HARNESS_LOG=true              # Log classifications
NALLY_HARNESS_VERIFY_RETRIES=2      # Max retries for claim verification
# Per-class pipeline overrides (JSON). Example:
# NALLY_HARNESS_PIPELINES={"SIMPLE": {"critique": true}}

# Security keys
# Encryption key (Fernet, base64 32-byte) REQUIRED by mcp/oauth.py to encrypt
# OAuth tokens at rest. If unset or cryptography is missing, credential
# persistence FAILS CLOSED (no plaintext). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# One-time legacy plaintext migration (optional): NALLY_ALLOW_PLAINTEXT_TOKEN_MIGRATE=1
NALLY_CRED_KEY=
# HMAC key used by nally/tools/receipts.py to sign tool execution receipts.
# If unset, Nally falls back to a persisted auto-generated key file (data/).
NALLY_RECEIPT_KEY=

# ── Custom curiosity scanner (proactive idle-cycle learning) ──
# Controls when Nally runs proactive learning tasks during idle time.
NALLY_CURIOSITY_ENABLED=true
NALLY_CURIOSITY_INTERVAL=21600       # Seconds between idle-cycle learning runs (default 6h)

# ── Embeddings (separate microservice — Free tier) ──
# NALLY main stays lean (<300MB free) — no torch. ONNX quantized MiniLM 22MB, 384d, 120MB RAM lives on separate Render Free instance.
# Option 1: self-hosted Free (no API cost) — deploy embed-api/ as separate Web Service on Render Free, then set:
#   NALLY_EMBED_PROVIDER=embed_api
#   NALLY_EMBED_BASE_URL=https://your-embed-free.onrender.com  # or http://embed-api:8000 for docker --profile with-embed
#   NALLY_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2  # 384d / 1.5KB per memory on Free
#   NALLY_EMBED_API_KEY=your-long-random-internal-token  # same as NALLY_INTERNAL_TOKEN
# Option 2: remote OpenAI-compatible — set NALLY_EMBED_BASE_URL=https://api.openai.com/v1, NALLY_EMBED_MODEL=text-embedding-3-small (1536d), provider=openai
# Default: none = keyword FTS only (no embeddings, zero cost, works offline)
NALLY_EMBED_PROVIDER=none
NALLY_EMBED_BASE_URL=
NALLY_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NALLY_EMBED_API_KEY=
NALLY_EMBED_DIMS=384
NALLY_EMBED_TIMEOUT=15
NALLY_EMBED_CACHE_TTL=3600
# Local docker: docker compose --profile with-embed up  (starts embed-api on :8000)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Web server port ──
# Render requires host 0.0.0.0 and port $PORT (default 10000) — https://render.com/docs/web-services#port-binding
# Local dev can keep 5000, but on Render set PORT=10000 (auto-injected). Avoid 18012/18013/19099 (reserved).
PORT=10000
NALLY_PORT=10000
